{
  "version": 2,
  "databaseCount": 1,
  "tableCount": 45,
  "tables": [
    "sessions", "messages", "config", "project_config", "file_snapshots", "tasks",
    "project_context", "activities", "anomaly_events", "run_envelopes", "run_event_log",
    "evidence_bundles", "evidence_items", "regression_scripts", "agent_checkpoints",
    "artifact_manifests", "artifact_entries", "interaction_requests",
    "websocket_session_binding", "permission_grants", "run_workbench_bindings",
    "run_acceptance_criteria", "memories", "projects", "auth_tokens",
    "task_dependencies", "task_budget_reservations", "task_result_blobs", "task_results",
    "task_result_receipts", "task_inbox_messages", "tool_invocations",
    "tool_result_postprocessing", "research_captures", "research_sources",
    "research_findings", "research_conflicts", "research_open_questions",
    "research_requirement_coverage", "execution_resources", "llm_calls",
    "evidence_verdict_events", "cron_jobs", "cron_occurrences", "zk_schema_metadata"
  ],
  "rule": "A production table must have a repository, a production consumer, and a restart test before its feature is enabled.",
  "wp11VerifiedConsumers": {
    "project_context": {
      "repository": "zk_db::Db::{save_project_context,find_project_context}",
      "consumer": "zk_engine::Engine dynamic project_context prompt section",
      "restartTest": "project_context::tests::latest_project_context_survives_reopen_without_git_access"
    },
    "anomaly_events": {
      "repository": "zk_db::Db::{save_anomaly_event,resolve_anomaly_event,find_anomalies_by_swarm,find_unresolved_anomalies}",
      "consumer": "zk_server Swarm result collector",
      "restartTest": "anomaly::tests::anomaly_detection_resolution_survives_reopen"
    }
  }
}
