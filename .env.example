# =============================================================================
# zkcode — Environment Configuration
# Copy this to .env and fill in your values: cp .env.example .env
# =============================================================================

# ===== Server Configuration =====
# macOS local Beta supports loopback only. Do not expose this service remotely.
ZK_HOST=127.0.0.1
# Local backend port
ZK_PORT=8082
# Log level: error | warn | info | debug | trace
ZK_LOG=info
# Rust tracing log level (overrides ZK_LOG for tracing macros)
RUST_LOG=info

# ===== Admin Authentication =====
# Admin password for /api/admin/login (leave empty to disable admin endpoints)
ZK_ADMIN_PASSWORD=

# ===== Authentication Mode =====
# The supported macOS-local mode is localhost.
ZK_AUTH_MODE=localhost

# ===== Database =====
# SQLite database path (relative to working directory or absolute)
ZK_DB_PATH=.zk/data.db

# ===== Workspace =====
# Default workspace root for directory browsing
ZK_WORKSPACE_DEFAULT_ROOT=
# Optional path boundary (comma-separated absolute paths; empty = unrestricted for this local app)
ZK_WORKSPACE_ALLOWED_ROOTS=
# Enable local directory and file pickers (direct local desktop only; never enable behind a reverse proxy)
ZK_LOCAL_PICKER_ENABLED=true

# ===== Static Resources =====
# Static file directory (auto-detected as resources/static if not set)
ZK_STATIC_DIR=

# ===== Scratchpad =====
# Server-side scratchpad root (defaults to {workspace_default_root}/.zk/scratchpad)
ZK_SCRATCHPAD_SYSTEM_ROOT=

# ===== CORS =====
# Additional loopback CORS origins for local development (comma-separated)
ZK_CORS_ALLOWED_ORIGINS=

# ===== Legacy Single-Provider LLM (Phase 1 / S9 behavior) =====
# If no multi-provider keys are configured, falls back to this single provider.
ZK_LLM_API_KEY=
ZK_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ZK_DEFAULT_MODEL=qwen3.8-max-0902
# Optional root Task spend limits. Leave both empty for unlimited token/cost usage.
# Usage and cost are still recorded; the wall-clock deadline remains enforced.
ZK_ROOT_TASK_TOKEN_BUDGET=
ZK_ROOT_TASK_COST_BUDGET_USD=
ZK_ROOT_TASK_DEADLINE_SECONDS=1800
# Read-only public first-run credential seed. This is not the runtime/user DB.
ZK_DEMO_CREDENTIAL_DB=configuration/bootstrap/demo-credentials.db
# 0 (default) disables the public demo credential and safely removes a proven
# legacy demo copy from the runtime DB; user-provided keys are preserved.
# Set exactly 1 only when intentionally validating the public release demo.
ZK_DEV_ALLOW_DEMO_CREDENTIAL=0

# ===== Multi-Provider LLM (Recommended) =====
# Support multiple LLM providers simultaneously. Fill in API keys for the
# providers you want to use. <NAME> is provider name uppercased with - replaced by _.

# DashScope (Alibaba Cloud - Qwen series)
LLM_PROVIDER_DASHSCOPE_API_KEY=
# Registry MCP tools (for example zhipu-websearch) prefer the regular DashScope
# key from Settings -> API Keys or these environment variables. If none exists,
# they can fall back to the Token Plan provider key below. The account must have
# the corresponding MCP service enabled; public demo values remain filtered
# when ZK_DEV_ALLOW_DEMO_CREDENTIAL=0.
DASHSCOPE_API_KEY=
# LLM_PROVIDER_DASHSCOPE_MODELS=qwen3.8-max-0902,qwen3.7-plus

# DashScope Token Plan (separate from pay-as-you-go; sk-sp- prefix)
LLM_PROVIDER_DASHSCOPE_TOKEN_PLAN_API_KEY=
# LLM_PROVIDER_DASHSCOPE_TOKEN_PLAN_MODELS=qwen3.8-max,qwen3.8-flash

# DeepSeek
LLM_PROVIDER_DEEPSEEK_API_KEY=
# LLM_PROVIDER_DEEPSEEK_MODELS=deepseek-v4-pro,deepseek-v4-flash

# Moonshot (Kimi)
LLM_PROVIDER_MOONSHOT_API_KEY=
# LLM_PROVIDER_MOONSHOT_MODELS=kimi-k3,moonshot-v1-128k

# Zhipu (GLM)
LLM_PROVIDER_ZHIPU_API_KEY=
# LLM_PROVIDER_ZHIPU_MODELS=glm-5.3,glm-5.3-flash

# MiniMax
LLM_PROVIDER_MINIMAX_API_KEY=
# LLM_PROVIDER_MINIMAX_MODELS=MiniMax-M3

# ZenMux (Anthropic / OpenAI / Google series)
LLM_PROVIDER_ZENMUX_API_KEY=
# LLM_PROVIDER_ZENMUX_MODELS=anthropic/claude-opus-4.8,anthropic/claude-fable-5,openai/gpt-5.6-sol,openai/gpt-6-astra,google/gemini-3.8-flash,x-ai/grok-4.6

# Anthropic (direct)
LLM_PROVIDER_ANTHROPIC_API_KEY=
# LLM_PROVIDER_ANTHROPIC_MODELS=claude-opus-4.8,claude-sonnet-4.5

# OpenAI (direct)
LLM_PROVIDER_OPENAI_API_KEY=
# LLM_PROVIDER_OPENAI_MODELS=gpt-4o,gpt-4o-mini

# ===== Python Sidecar =====
# Master switch (false = no process spawn, no bridge tools registered)
ZK_PYTHON_ENABLED=true
# Explicit development socket override (standalone Rust defaults to ~/.zkcode/python.sock).
ZK_PYTHON_UDS=.runtime/python.sock
# Python service working directory
ZK_PYTHON_SERVICE_DIR=python-service
# Python interpreter (auto-detected if not set: venv -> python3.11 -> python3)
ZK_PYTHON_CMD=
# Health check polling interval in milliseconds
ZK_PYTHON_HEALTH_CHECK_INTERVAL_MS=30000
# Browser runtime installed project-locally by ./dev sync
BROWSER_TYPE=chromium
# Leave empty to use Playwright's pinned Chromium; set to chrome only to use a locally installed Chrome channel.
BROWSER_CHANNEL=

# ===== Production Capability Gates =====
# These gates control whether capabilities are assembled into the production service.
ZK_AGENT_ENABLED=true
# Worktree child writes use scoped authorization, read-before-write CAS and durable cleanup.
# readOnly isolation stays read-only; sharedWorkspace has its separate gate below.
ZK_AGENT_WRITE_ENABLED=true
# sharedWorkspace additionally requires the production process-wide workspace lease.
ZK_SHARED_WORKSPACE_ENABLED=false
# Parsed for fail-closed deployment visibility only; no automatic recovery entry exists yet.
ZK_AUTO_RESUME_SAFE_TASKS=false
# Persistent Cron stays off until explicitly enabled with the Agent runtime available.
ZK_CRON_ENABLED=false
# Deployment intent only: setting true currently fails readiness and does not enable execution.
ZK_SWARM_ENABLED=false
# Isolated snapshots are retained for review. Commit/merge/remove require explicit operations.
# Real Git + production child-write/authorization/ledger acceptance tests pass.
ZK_WORKTREE_ENABLED=true

# MCP capability identity and authorization registry
MCP_REGISTRY_PATH=configuration/mcp/mcp_capability_registry.json

# ===== Feature Flags =====
# Native prefix: ZK_FEATURE_<NAME> (higher priority)
# Legacy prefix: FEATURE_<NAME> (backward compatible with zhikuncode)
# Boolean flags (true/false):
ZK_FEATURE_THINKING_MODE=true
ZK_FEATURE_COORDINATOR_MODE=true
ZK_FEATURE_AGENT_TRIGGERS=false
ZK_FEATURE_WEB_BROWSER_TOOL=true
ZK_FEATURE_GIT_ENHANCED_TOOL=true
ZK_FEATURE_RUNTIME_VERIFICATION=true
ZK_FEATURE_RESOURCE_MONITOR=false
# Process-level top-level Coordinator opt-in. Only 0/1 is accepted; changes require restart.
# Effective mode also requires ZK_FEATURE_COORDINATOR_MODE=true and ZK_AGENT_ENABLED=true.
ZHIKUN_COORDINATOR_MODE=0
# Bare-name placeholder flags (read without prefix):
SELF_CORRECTION_LOOP=false

# ===== Migrated provider and context options =====
# New channels; unset keys leave the channel disabled. Existing model choices remain valid.
LLM_PROVIDER_KIMI_CODE_API_KEY=
# LLM_PROVIDER_KIMI_CODE_MODELS=k3,kimi-for-coding
LLM_PROVIDER_OPENROUTER_API_KEY=
# LLM_PROVIDER_OPENROUTER_MODELS=stealth/union-alpha,openrouter/openai/gpt-6-astra,openrouter/anthropic/claude-fable-5.1
# Bailian GLM uses dashscope-token-plan with model bailian/glm-5.3.
# API_KEY accepts comma-separated keys. ZenMux defaults to PRIORITY_FAILOVER;
# other providers retain ROUND_ROBIN. Set per provider to override explicitly.
# LLM_PROVIDER_ZENMUX_KEY_SELECTION_STRATEGY=PRIORITY_FAILOVER
# A subscription key never falls back to a listed paid key without this opt-in.
LLM_PROVIDER_ZENMUX_ALLOW_PAID_FAILOVER=false
# Physical retries, summaries and fallbacks all use the existing task cost/token budget.
# ZK_MODEL_FALLBACK_CHAIN=kimi-k3:qwen3.8-max-0902
# Optional vision preference; the configured target must actually support images.
# ZK_VISION_FALLBACK_MODEL=kimi-k3
# Existing auxiliary routing defaults remain unchanged; override only intentionally.
# ZK_LIGHTWEIGHT_MODEL=qwen3.8-flash
# Optional fast route for auxiliary calls; an existing ZK_LIGHTWEIGHT_MODEL wins.
# ZK_FAST_MODEL=deepseek-v4.1-flash
# LLM_FAST_MODEL is accepted as a compatibility alias; unavailable models retain the old route.

# Independent compaction does not replace the current conversation model.
# When this isolated provider is unavailable, use the bounded local compaction path.
LLM_COMPACT_PROVIDER=deepseek
LLM_COMPACT_MODEL=deepseek-flash
LLM_COMPACT_LLM_ENABLED=true
LLM_COMPACT_THINKING_MODE=max
LLM_COMPACT_MAX_COMPLETION_TOKENS=8192
LLM_COMPACT_MAX_SUMMARY_TOKENS=4096
LLM_COMPACT_TIMEOUT_MS=90000

# Initial wait for an interaction client. Later dispatch/acknowledgement/answer
# stages have separate deadlines; none may exceed the owning task's deadline.
ZK_INTERACTION_FIRST_CLIENT_WAIT_SECONDS=600
# ASR chat context is an optional UI switch, disabled by default.
# Hotword syntax: canonical:variant1,variant2;another:variant3
# ASR_CORRECTIONS=zkcode:zk code,z k code;zhikuncode:zhi kun code,智坤code
