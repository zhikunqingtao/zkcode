# =============================================================================
# zkcode — Environment Configuration
# Copy this to .env and fill in your values: cp .env.example .env
# =============================================================================

# ===== Server Configuration =====
# macOS local Beta supports loopback only. Do not expose this service remotely.
ZK_HOST=127.0.0.1
# Local backend port
ZK_PORT=8081
# Log level: error | warn | info | debug | trace
ZK_LOG=info
# Rust tracing log level (overrides ZK_LOG for tracing macros)
RUST_LOG=info

# ===== Admin Authentication =====
# Admin password for /api/admin/login (leave empty to disable admin endpoints)
ZK_ADMIN_PASSWORD=

# ===== Authentication Mode =====
# The supported macOS-local mode is localhost.
ZK_AUTH_MODE=localhost

# ===== Database =====
# SQLite database path (relative to working directory or absolute)
ZK_DB_PATH=.zk/data.db

# ===== Workspace =====
# Default workspace root for directory browsing
ZK_WORKSPACE_DEFAULT_ROOT=
# Allowed workspace roots (comma-separated absolute paths; empty = unrestricted but guarded by local picker)
ZK_WORKSPACE_ALLOWED_ROOTS=
# Enable local directory picker (direct local desktop only; never enable behind a reverse proxy)
ZK_LOCAL_PICKER_ENABLED=true

# ===== Static Resources =====
# Static file directory (auto-detected as resources/static if not set)
ZK_STATIC_DIR=

# ===== Scratchpad =====
# Server-side scratchpad root (defaults to {workspace_default_root}/.zk/scratchpad)
ZK_SCRATCHPAD_SYSTEM_ROOT=

# ===== CORS =====
# Additional loopback CORS origins for local development (comma-separated)
ZK_CORS_ALLOWED_ORIGINS=

# ===== Legacy Single-Provider LLM (Phase 1 / S9 behavior) =====
# If no multi-provider keys are configured, falls back to this single provider.
ZK_LLM_API_KEY=
ZK_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ZK_DEFAULT_MODEL=qwen3.7-max

# ===== Multi-Provider LLM (Recommended) =====
# Support multiple LLM providers simultaneously. Fill in API keys for the
# providers you want to use. <NAME> is provider name uppercased with - replaced by _.

# DashScope (Alibaba Cloud - Qwen series)
LLM_PROVIDER_DASHSCOPE_API_KEY=
# LLM_PROVIDER_DASHSCOPE_MODELS=qwen3.7-max,qwen3.6-plus

# DashScope Token Plan (separate from pay-as-you-go; sk-sp- prefix)
LLM_PROVIDER_DASHSCOPE_TOKEN_PLAN_API_KEY=
# LLM_PROVIDER_DASHSCOPE_TOKEN_PLAN_MODELS=qwen3.8-max

# DeepSeek
LLM_PROVIDER_DEEPSEEK_API_KEY=
# LLM_PROVIDER_DEEPSEEK_MODELS=deepseek-v4-pro,deepseek-v4-flash

# Moonshot (Kimi)
LLM_PROVIDER_MOONSHOT_API_KEY=
# LLM_PROVIDER_MOONSHOT_MODELS=kimi-k3,moonshot-v1-128k

# Zhipu (GLM)
LLM_PROVIDER_ZHIPU_API_KEY=
# LLM_PROVIDER_ZHIPU_MODELS=glm-5.2,glm-5v-turbo

# MiniMax
LLM_PROVIDER_MINIMAX_API_KEY=
# LLM_PROVIDER_MINIMAX_MODELS=MiniMax-M3

# ZenMux (Anthropic Claude series)
LLM_PROVIDER_ZENMUX_API_KEY=
# LLM_PROVIDER_ZENMUX_MODELS=anthropic/claude-opus-4.8,anthropic/claude-fable-5

# Anthropic (direct)
LLM_PROVIDER_ANTHROPIC_API_KEY=
# LLM_PROVIDER_ANTHROPIC_MODELS=claude-opus-4.8,claude-sonnet-4.5

# OpenAI (direct)
LLM_PROVIDER_OPENAI_API_KEY=
# LLM_PROVIDER_OPENAI_MODELS=gpt-4o,gpt-4o-mini

# ===== Python Sidecar =====
# Master switch (false = no process spawn, no bridge tools registered)
ZK_PYTHON_ENABLED=true
# Local Unix domain socket path
ZK_PYTHON_UDS=~/.zkcode/python.sock
# Python service working directory
ZK_PYTHON_SERVICE_DIR=python-service
# Python interpreter (auto-detected if not set: venv -> python3.11 -> python3)
ZK_PYTHON_CMD=
# Health check polling interval in milliseconds
ZK_PYTHON_HEALTH_CHECK_INTERVAL_MS=30000
# Browser runtime installed by scripts/setup-python-macos.sh
BROWSER_TYPE=chromium
# Leave empty to use Playwright's pinned Chromium; set to chrome only to use a locally installed Chrome channel.
BROWSER_CHANNEL=

# ===== Production Capability Gates =====
# These gates control whether capabilities are assembled into the production service.
ZK_AGENT_ENABLED=true
ZK_AGENT_WRITE_ENABLED=true
ZK_SWARM_ENABLED=true
# Real Git E2E has not been accepted. Keep Worktree disabled.
ZK_WORKTREE_ENABLED=false

# MCP capability identity and authorization registry
MCP_REGISTRY_PATH=configuration/mcp/mcp_capability_registry.json

# ===== Feature Flags =====
# Native prefix: ZK_FEATURE_<NAME> (higher priority)
# Legacy prefix: FEATURE_<NAME> (backward compatible with zhikuncode)
# Boolean flags (true/false):
ZK_FEATURE_THINKING_MODE=true
ZK_FEATURE_COORDINATOR_MODE=true
ZK_FEATURE_AGENT_TRIGGERS=false
ZK_FEATURE_WEB_BROWSER_TOOL=true
ZK_FEATURE_GIT_ENHANCED_TOOL=true
ZK_FEATURE_RUNTIME_VERIFICATION=true
ZK_FEATURE_RESOURCE_MONITOR=false
# Automatic top-level Coordinator behavior remains opt-in; explicit Swarm APIs are unaffected.
ZHIKUN_COORDINATOR_MODE=0
# Bare-name placeholder flags (read without prefix):
SELF_CORRECTION_LOOP=false
